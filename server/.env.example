# Node 22.9+. Copy to server/.env; dev/start automatically load that file if it
# exists. Hosted environment variables take precedence over the file.
PORT=8787
NODE_ENV=development
# Exact frontend origins, no trailing slash. For GitHub Pages use https://USER.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact hostnames only. Every redirect must also be in this list.
# Add only sources you trust and are authorized to download from. Never use *.
ALLOWED_MEDIA_HOSTS=images.unsplash.com,upload.wikimedia.org,media.w3.org,interactive-examples.mdn.mozilla.net
MAX_FILE_BYTES=104857600
REQUEST_TIMEOUT_MS=20000
MEDIA_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_DOWNLOADS=4
# Keep 0 locally. Set 1 only when exactly one trusted reverse proxy fronts this
# application (e.g. your configured hosting ingress). Never use true/unbounded.
TRUST_PROXY_HOPS=0
