# Node 22.9+. Copy to server/.env; dev/start automatically load that file if it
# exists. Hosted environment variables take precedence over the file.
PORT=8787
NODE_ENV=development
# Exact frontend origins, no trailing slash. For GitHub Pages use https://USER.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public direct media is enabled by default. Set false to require exact hosts.
ALLOW_PUBLIC_MEDIA=true
# Exact hostnames used when ALLOW_PUBLIC_MEDIA=false; no wildcards.
ALLOWED_MEDIA_HOSTS=images.unsplash.com,upload.wikimedia.org,media.w3.org,interactive-examples.mdn.mozilla.net
# Real public video-page resolution; install tools with npm run setup:media -w server.
EXTRACTOR_ENABLED=true
# Defaults: server/.bin/yt-dlp and its adjacent deno/deno.exe.
# EXTRACTOR_PATH=/absolute/path/to/yt-dlp
# DENO_PATH=/absolute/path/to/deno
# Python 3.10+ required (3.11+ recommended); use an absolute executable path on Windows.
PYTHON_PATH=python3
FFMPEG_PATH=ffmpeg
EXTRACTION_TIMEOUT_MS=65000
DOWNLOAD_TIMEOUT_MS=120000
MAX_FILE_BYTES=104857600
REQUEST_TIMEOUT_MS=20000
MEDIA_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_DOWNLOADS=4
# Keep 0 locally. Set 1 only when exactly one trusted reverse proxy fronts this
# application (e.g. your configured hosting ingress). Never use true/unbounded.
TRUST_PROXY_HOPS=0
